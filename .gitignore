# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.out.*
coverage.*
*.cover
profile.cov
cover.html

# Go workspace file
go.work
go.work.sum

# Dependency directories (populated by `go mod vendor`)
vendor/

# Go build and module cache (when set locally)
/bin/
/dist/
/build/

# Compiled example programs (each example is a `package main`; `go build`
# produces a binary named after its directory). Never commit these artifacts.
/examples/basic/basic
/examples/fifo/fifo
/examples/fifo-scheduled-retry/fifo-scheduled-retry
/examples/localscheduler/localscheduler
/examples/middleware/middleware
/examples/producer/producer
/examples/typed/typed

# Fuzzing corpus generated by `go test -fuzz`
**/testdata/fuzz/

# Delve debugger binaries
__debug_bin*
debug.test

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl
.terraform.tfstate.lock.info

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
.volume/

# ---------------------------------------------------------------------------
# Temporary files
# ---------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*tmp/
tmp/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# IDE / Editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.code-workspace
.history/

# ---------------------------------------------------------------------------
# OS generated files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Kiro (keep specs, ignore local steering/workflow config)
# ---------------------------------------------------------------------------
.kiro/steering/

# ---------------------------------------------------------------------------
# Node (dev-only tooling: commitlint)
# ---------------------------------------------------------------------------
node_modules/
